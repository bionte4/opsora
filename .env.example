# PostgreSQL (pgvector/pgvector:pg16)
POSTGRES_USER=opsora
POSTGRES_PASSWORD=opsora
POSTGRES_DB=opsora
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (job queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=opsora
REDIS_DB=0

# Connection strings for the application
DATABASE_URL=postgresql://opsora:opsora@localhost:5432/opsora
REDIS_URL=redis://:opsora@localhost:6379/0

# API server
PORT=8080
GITHUB_WEBHOOK_SECRET=change-me

# Web console. The first boot creates this admin only when no users exist.
# Change the password before anyone else can reach port 8080.
ADMIN_EMAIL=admin@opsora.local
ADMIN_PASSWORD=change-me

# Worker
# Token with read access to repository contents and write access to commit
# statuses. Without it the worker clones public repositories only and does
# not report statuses to GitHub.
GITHUB_TOKEN=
# Public base URL of the API, used for the "Details" link on GitHub commit
# statuses and the "Full logs" link in Telegram messages.
OPSORA_PUBLIC_URL=

# Telegram notifier. Create a bot with @BotFather, send it a message, then read
# the chat ID from https://api.telegram.org/bot<token>/getUpdates. Leave empty
# to keep the notifier idle.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# all = every finished build, failures = failed builds only.
TELEGRAM_NOTIFY=all

# AI service: explains failed builds in Telegram messages.
# ollama = a model on a machine you control (default).
# openai = any OpenAI-compatible API, including Groq's free tier.
#   AI_PROVIDER=openai
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_API_KEY=
#   AI_MODEL=llama-3.1-8b-instant
# The API key is sent only as a bearer token and is never logged. About 60
# lines of a failed step's log are included in the request.
AI_PROVIDER=ollama
AI_MODEL=phi3
# Optional. A 768-dimension embedding model enables similar-failure search.
# For Ollama: ollama pull nomic-embed-text
# AI_EMBED_MODEL=nomic-embed-text
# AI_BASE_URL=
# AI_API_KEY=
# Language of the summary, e.g. English or Indonesian.
AI_LANGUAGE=English
AI_TIMEOUT=120s
# How long Ollama keeps the model in memory after a request. phi3 holds about
# 4 GB, so keep this short on machines with 8 GB of RAM.
AI_KEEP_ALIVE=2m
# Outside Compose use http://localhost:11434. Compose defaults to the host.
# OLLAMA_URL=
# Set to an empty value to turn AI analysis off in the API and notifier.
# AI_SERVICE_URL=

# ChatOps. The same Telegram bot answers /status, /logs, /rerun and /rollback.
# CHATOPS_TOKEN is a shared secret between the notifier and the API. Generate
# one with: openssl rand -hex 24
# CHATOPS_ALLOWED_CHATS is a comma-separated list of Telegram chat IDs.
# Commands from any other chat are rejected.
CHATOPS_TOKEN=
CHATOPS_ALLOWED_CHATS=

# Optional bearer token for GET /api/builds without a browser session.
# Leave empty to require a signed-in console user.
# API_READ_TOKEN=

# Metrics listen address when running a service outside Compose. Defaults:
# api-server :9101, worker :9102, notifier :9103, ai-service :9104.
# METRICS_ADDR=

# Observability (docker compose)
API_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
