# PostgreSQL (pgvector/pgvector:pg16)
POSTGRES_USER=opsora
POSTGRES_PASSWORD=opsora
POSTGRES_DB=opsora
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (job queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=opsora
REDIS_DB=0

# Connection strings for the application
DATABASE_URL=postgresql://opsora:opsora@localhost:5432/opsora
REDIS_URL=redis://:opsora@localhost:6379/0

# API server
PORT=8080
GITHUB_WEBHOOK_SECRET=change-me

# Worker
# Token with read access to repository contents and write access to commit
# statuses. Without it the worker clones public repositories only and does
# not report statuses to GitHub.
GITHUB_TOKEN=
# Public base URL of the API, used for the "Details" link on GitHub commit
# statuses and the "Full logs" link in Telegram messages.
OPSORA_PUBLIC_URL=

# Telegram notifier. Create a bot with @BotFather, send it a message, then read
# the chat ID from https://api.telegram.org/bot<token>/getUpdates. Leave empty
# to keep the notifier idle.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# all = every finished build, failures = failed builds only.
TELEGRAM_NOTIFY=all

# Metrics listen address when running a service outside Compose. Defaults:
# api-server :9101, worker :9102, notifier :9103.
# METRICS_ADDR=

# Observability (docker compose)
API_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
